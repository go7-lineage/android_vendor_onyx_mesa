soong_namespace {
}

cc_prebuilt_library_shared {
    name: "libgallium_dri",
    vendor: true,
    compile_multilib: "64",
    strip: {
        none: true,
    },
    target: {
        android_arm64: {
            srcs: ["prebuilt/libgallium_dri.so"],
        },
    },
    shared_libs: [
        "libcutils",
        "libdrm",
        "liblog",
        "libsync",
        "libz",
    ],
}

cc_prebuilt_library_shared {
    name: "libEGL_mesa",
    vendor: true,
    relative_install_path: "egl",
    compile_multilib: "64",
    strip: {
        none: true,
    },
    target: {
        android_arm64: {
            srcs: ["prebuilt/libEGL_mesa.so"],
        },
    },
    shared_libs: [
        "libcutils",
        "libdrm",
        "libgallium_dri",
        "libhardware",
        "liblog",
        "libnativewindow",
        "libsync",
    ],
}

